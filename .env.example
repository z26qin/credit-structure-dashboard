# Copy to .env. Never commit .env.
# SEC EDGAR requires a User-Agent naming you, with a contact email.
SEC_USER_AGENT=Your Name you@example.com
SEC_MAX_RPS=5

# DeepSeek, as in research-relay. Only the debt-footnote extraction uses it.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# LLM_MAX_INPUT_TOKENS=100000

