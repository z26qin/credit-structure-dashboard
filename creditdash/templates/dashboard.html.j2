<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ d.company.ticker }} credit structure</title>
<style>{{ css }}</style>
</head>
<body>
<main class="cw">
  <header class="cw-head" id="overview">
    <p class="cw-kicker">{{ d.company.name }} · {{ d.company.ticker }} · {{ d.filing.form }} for the period ended {{ d.financials.period_end }}</p>
    <h1 class="cw-title">{{ d.company.ticker }} debt stack, maturity wall and coverage</h1>
    <div class="cw-badges">
      <span class="cw-badge is-{{ d.reconciliation.status.value }}" id="recon-badge">Reconciliation: {{ d.reconciliation.status.value }}</span>
      <span class="cw-note" id="recon-detail"></span>
    </div>
    {% for line in d.basis %}<p class="cw-info">{{ line }}</p>{% endfor %}
    {% if d.extraction_skipped %}<p class="cw-banner">instrument detail unavailable: {{ d.extraction_skipped }}</p>{% endif %}
    {% if no_rate %}<p class="cw-banner">Interest not modeled for: {{ no_rate | join(", ") }} (no coupon, spread or SOFR available); coverage is overstated.</p>{% endif %}
    {% if matured %}<p class="cw-banner">Matured before the period end and left out: {{ matured | join(", ") }} (the instrument list is from an older filing).</p>{% endif %}
    <div class="cw-controls">
      <span class="cw-note">EBITDA scenario</span>
      <div class="cw-seg" role="group" aria-label="EBITDA scenario" id="scenario-ctl"></div>
    </div>
    <p class="cw-note">Debt per the {{ d.filing.form }} filed {{ d.filing.filed }} ({{ d.filing.accession }}){% if d.extraction and d.extraction.instruments | selectattr("post_period_change") | list %}, pro forma for changes after the period end{% endif %}. Money in US dollars; built {{ d.built_at.strftime("%Y-%m-%d %H:%M") }}.</p>
  </header>

  {% set r = d.risk %}{% set h = d.model.headline %}
  {% set VERDICT = {"overreaction": "Looks like an overreaction", "fair": "Price roughly fits the cash flow", "underpricing": "Market may be underpricing risk", "unclear": "Unclear"} %}
  {% set STATUS = {"covered": "Covered", "thin": "Thin", "not_covered": "Not covered", "n/a": "No data"} %}
  <section class="cw-risk{% if r and r.assessment %} is-{{ r.assessment.verdict }}{% endif %}" id="risk" aria-label="Market-implied default risk vs cash flow">
    <div class="cw-risk-head">
      <h2>Market-implied default risk vs cash flow</h2>
      {% if r and r.assessment %}<span class="cw-verdict">{{ VERDICT[r.assessment.verdict] }}</span>{% endif %}
    </div>
    <div class="cw-risk-cols">
      <div class="cw-risk-col">
        <h3>What the market prices</h3>
        {% if r and r.implied %}
        <div class="cw-risk-nums">
          <div><span class="cw-kpi-label">Implied default, 1 year</span><span class="cw-kpi-value">{{ "%.1f"|format(r.implied.pd_1y * 100) }}%</span></div>
          <div><span class="cw-kpi-label">Implied default, 5 years</span><span class="cw-kpi-value">{{ "%.1f"|format(r.implied.pd_5y * 100) }}%</span></div>
          <div><span class="cw-kpi-label">Spread</span><span class="cw-kpi-value">{{ "%.0f"|format(r.implied.spread_bps) }} bp</span><span class="cw-kpi-sub">{{ r.implied.basis }} · recovery {{ "%.0f"|format(r.implied.recovery * 100) }}%</span></div>
        </div>
        {% else %}
        <p class="cw-note">No CDS or bond yield given: add <code>cds_5y_bps</code> or <code>bond_yields</code> to overrides/{{ d.company.ticker }}.yaml to compare with the market.</p>
        {% endif %}
      </div>
      {% if h %}
      <div class="cw-risk-col">
        <h3>Can it pay its interest? Next 12 months</h3>
        <div class="cw-tests">
          {% for t in h.tests %}
          <div class="cw-test">
            <span class="cw-kpi-label">{{ t.label }}</span>
            <span class="cw-kpi-value">{{ "%.1fx"|format(t.value) if t.value is not none else "—" }}</span>
            <span class="cw-status is-{{ t.status }}">{{ STATUS[t.status] }}</span>
            <span class="cw-kpi-sub">{{ t.detail }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
    {% set a = r.assessment if r else none %}
    {% if (h and h.bottom_line) or a %}
    <dl class="cw-read">
      {% if h and h.bottom_line %}<dt>Bottom line</dt>
      <dd>{% if h.funding %}<b>{{ h.funding }}.</b> {% endif %}{{ h.bottom_line }}</dd>{% endif %}
      {% if a %}<dt>Model's read</dt>
      <dd><ul>{% for x in a.reasons %}<li>{{ x }}</li>{% endfor %}</ul></dd>
      {% if a.watch %}<dt>Watch</dt><dd>{{ a.watch }}</dd>{% endif %}{% endif %}
    </dl>
    {% endif %}
    <p class="cw-note">Covered: 2.0x or more (liquidity 1.5x); thin: 1.0x or more.{% if a %} The model's read uses only the figures above, and code fills in every number in it.{% endif %}{% if r and r.implied and r.implied.basis.startswith("worst bond") %} A single bond's yield can also reflect convertible terms or thin trading.{% endif %}</p>
    {% if r and r.note and r.implied %}<p class="cw-note">{{ r.note }}</p>{% endif %}
  </section>

  <section class="cw-kpis" id="kpis" aria-label="Headline figures"></section>

  <h2 class="cw-h2">Capital structure</h2>
  <div class="cw-grid">
    <section class="cw-card" id="stack">
      <h3>Capital structure, senior to junior</h3>
      <p class="cw-note">Each class's height is its share of debt plus equity at market value. The attachment point is the share of capital junior to the class.</p>
      <div class="cw-chart" id="stack-chart"></div>
    </section>
    <section class="cw-card" id="yield">
      <h3>Yield by tranche and maturity</h3>
      <p class="cw-note" id="yield-note">Bubble size is the balance.</p>
      <div class="cw-chart" id="yield-chart"></div>
      <div class="cw-legend" id="yield-legend"></div>
    </section>
  </div>
  <section class="cw-card" id="paying">
    <h3>Debt by what it pays</h3>
    <p class="cw-note">Balance per instrument with its rate (disclosed effective rate, else all-in coupon), highest rate first.</p>
    <div class="cw-chart" id="paying-chart"></div>
    <div class="cw-legend" id="paying-legend"></div>
  </section>

  <h2 class="cw-h2">When the payouts hit the wall</h2>
  <section class="cw-card" id="wall">
    <h3>Payout wall vs EBITDA</h3>
    <div class="cw-seg" role="group" aria-label="What the wall shows" id="wall-mode"></div>
    <p class="cw-note" id="wall-note">Interest plus scheduled principal on today's debt by fiscal year, stacked senior (bottom) to junior. The line is EBITDA under the chosen scenario; a red bracket marks payout it does not cover. Click a year to open its waterfall.</p>
    <div class="cw-chart" id="wall-chart"></div>
    <div class="cw-legend" id="wall-legend"></div>
  </section>
  <div class="cw-grid">
    <section class="cw-card" id="coverage">
      <h3>Coverage, scenario chosen above</h3>
      <p class="cw-note">EBITDA ÷ each year's interest, assuming maturities are refinanced at today's average rate so their interest keeps running. The dashed line counts today's debt only and climbs as it matures; the gray line adds scheduled principal. Below 1.0x the gap has to be refinanced or raised.</p>
      <div class="cw-chart" id="coverage-chart"></div>
      <div class="cw-legend" id="coverage-legend"></div>
    </section>
    <section class="cw-card" id="raise">
      <h3>Cash to raise each year</h3>
      <p class="cw-note" id="raise-note">Capex plus scheduled principal, less cash from operations. The red part has to come from new debt or equity.</p>
      <div class="cw-chart" id="raise-chart"></div>
      <div class="cw-legend" id="raise-legend"></div>
    </section>
  </div>
  <section class="cw-card" id="waterfall">
    <h3>Cash waterfall</h3>
    <p class="cw-note">Where a year of EBITDA goes: each class is paid interest and principal in seniority order; a shortfall shows where cash runs out.</p>
    <div class="cw-chips" id="waterfall-years" role="group" aria-label="Year"></div>
    <div class="cw-chart" id="waterfall-chart"></div>
    <div class="cw-legend" id="waterfall-legend"></div>
  </section>

  <section class="cw-card" id="instruments">
    <h3>Every instrument, senior to junior</h3>
    <p class="cw-note">Click a column name to sort. Balance is pro forma for post-period changes. Rows marked unverified had a quote the filing text does not contain.</p>
    <div class="cw-table-wrap"><table class="cw-table" id="instrument-table"></table></div>
  </section>

  <section class="cw-card cw-method" id="method">
    <h3>Sources and method</h3>
    <div id="method-body"></div>
  </section>
</main>
<div class="cw-tip" id="tip"></div>
<script id="dashboard-data" type="application/json">{{ data_json }}</script>
<script>{{ d3 }}</script>
<script>{{ js }}</script>
</body>
</html>
