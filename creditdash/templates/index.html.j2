<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Credit structure dashboards</title>
<style>
  :root { --bg: #faf9f5; --panel: #fff; --fg: #1f1e1d; --muted: #6b6a66; --line: #e4e2da; --bad: #c2410c; --ok: #2f7d4f;
          --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
          --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; color-scheme: light dark; }
  @media (prefers-color-scheme: dark) { :root { --bg: #191917; --panel: #22221f; --fg: #ecebe6; --muted: #a5a39b; --line: #3a3934; --bad: #f08a5d; --ok: #6cc08f; } }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--sans); font-size: 15px; }
  main { max-width: 720px; margin: 0 auto; padding: 40px 16px; display: flex; flex-direction: column; gap: 24px; }
  h1 { font-family: var(--serif); font-weight: 400; font-size: 30px; margin: 0; }
  p { margin: 0; color: var(--muted); line-height: 1.5; }
  form { display: flex; gap: 8px; flex-wrap: wrap; }
  input { font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); color: var(--fg); flex: 1 1 12rem; text-transform: uppercase; }
  button { font: inherit; padding: 10px 18px; border-radius: 8px; border: 1px solid var(--fg); background: var(--fg); color: var(--bg); cursor: pointer; }
  button:disabled { opacity: .5; cursor: default; }
  #status { min-height: 1.5em; font-size: 13px; }
  #status.is-error { color: var(--bad); }
  ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  li { border-bottom: 1px solid var(--line); }
  li a { display: flex; justify-content: space-between; padding: 12px 4px; color: inherit; text-decoration: none; }
  li a:hover { background: var(--panel); }
  li span { color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
</head>
<body>
<main>
  <div>
    <h1>Credit structure dashboards</h1>
    <p>Type a ticker of a company that files 10-Ks and 10-Qs with the SEC. The build reads its latest filing, extracts the debt instruments and opens the dashboard.</p>
  </div>
  <form id="build-form">
    <input id="ticker" name="ticker" placeholder="CRWV" autocomplete="off" maxlength="10" required aria-label="Ticker">
    <button type="submit" id="go">Build</button>
  </form>
  <p id="status" role="status"></p>
  <section>
    <p>Built</p>
    <ul>
      {% for d in dashboards %}<li><a href="{{ d.url }}">{{ d.ticker }} <span>{{ d.period }}</span></a></li>
      {% else %}<li><p style="padding:12px 4px">Nothing built yet.</p></li>{% endfor %}
    </ul>
  </section>
</main>
<script>
(function () {
  const form = document.getElementById("build-form"), input = document.getElementById("ticker");
  const go = document.getElementById("go"), status = document.getElementById("status");
  const say = (text, bad) => { status.textContent = text; status.className = bad ? "is-error" : ""; };
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const ticker = input.value.trim().toUpperCase();
    if (!ticker) return;
    go.disabled = true;
    say("Starting " + ticker + "…");
    try {
      const r = await fetch("/build", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ ticker }) });
      const body = await r.json();
      if (!r.ok) throw new Error(body.detail || r.statusText);
      for (;;) {
        await new Promise((res) => setTimeout(res, 800));
        const job = await (await fetch("/jobs/" + body.job)).json();
        if (job.status === "done") { window.location.href = job.path; return; }
        if (job.status === "error") throw new Error(job.error);
        say(ticker + ": " + job.stage + "…");
      }
    } catch (e) {
      say(String(e.message || e), true);
      go.disabled = false;
    }
  });
})();
</script>
</body>
</html>
